# govcheck 環境變數範例 — 複製為 .env 後依需求調整（.env 已 gitignore，勿入庫）。
# 所有變數皆有硬碼/YAML 預設值，可留空或整段不設；機密（api_key/token）僅能由環境變數提供，
# 禁止寫入 src/govcheck/config/*.yaml。
# 詳細語意見 src/govcheck/logging_setup.py / llm/config.py / rag/config.py。

# ── Logging（技術維運 + 治理稽核） ──────────────────────────────────────────
# profile 細節程度總開關：dev=全流程(DEBUG) / prod=重點(INFO) / quiet=只剩錯誤(WARNING)
# 所有 profile 都禁止落地 LLM request/response、Prompt 變數及文件內容。
GOVCHECK_LOG_PROFILE=prod
# 細粒度覆寫（留空 → 由 profile 推導）：DEBUG / INFO / WARNING / ERROR / CRITICAL
GOVCHECK_LOG_LEVEL=
# log 檔輸出目錄（留空 → repo root/logs）
GOVCHECK_LOG_DIR=
# 是否同時輸出到 console(stderr)
GOVCHECK_LOG_CONSOLE=true
# 單一 log 檔輪替門檻（bytes）與保留份數
GOVCHECK_LOG_MAX_BYTES=5000000
GOVCHECK_LOG_BACKUP_COUNT=5
# 稽核記錄「誰」（目前無登入機制，best-effort 手動填）
GOVCHECK_OPERATOR=

# ── LLM 判讀端點（F03 佐證比較；OpenAI 相容 chat/completions） ──────────────
# 預設關閉；設 1 才會呼叫 LLM（否則僅跑規則式檢查）
GOVCHECK_LLM_ENABLED=false
# 本機開發預設走 ollama；內部/正式端點請覆寫為行內部署位址
GOVCHECK_LLM_BASE_URL=http://localhost:11434/v1
# 本機 ollama 範例模型；請依實際部署覆寫
GOVCHECK_LLM_MODEL=gemma3:4b
# 機密：僅走環境變數，禁止寫入 yaml。本機 ollama 通常免填。
GOVCHECK_LLM_API_KEY=
# 單次請求逾時（秒）。60 是給內部端點的值；本機 ollama 跑較大的模型做 F03 批次判讀
# 會超過它（逾時屬 RequestException 會重試一次，實際等待是兩倍），地端測試請調大或換小模型。
GOVCHECK_LLM_TIMEOUT=60
# 判讀求穩定，預設 0
GOVCHECK_LLM_TEMPERATURE=0
# 單次審查送 LLM 的檢核項上限（安全閥）
GOVCHECK_LLM_MAX_ITEMS=30
# 模型輸出 token 上限；Prompt Manager 的 max_tokens 不會覆寫此值
GOVCHECK_LLM_MAX_OUTPUT_TOKENS=4096
# 模型完整 context window；必須與地端部署實際值一致
GOVCHECK_LLM_CONTEXT_WINDOW_TOKENS=30000
# 額外保留給 tokenizer 差異與 chat framing 的安全空間
GOVCHECK_LLM_CONTEXT_SAFETY_MARGIN_TOKENS=1024
# F03 每批項目硬上限；context/output budget 仍會再自動縮小
GOVCHECK_LLM_BATCH_SIZE=8

# ── Prompt Management（正式 Prompt 不進 Git） ─────────────────────────────
# disabled / file / litellm。維持 disabled 會讓 F03 語意判讀整批降級為「未判讀」，
# 並在報告出現 F03.PROMPT_UNAVAILABLE；要跑語意判讀請設 file（地端）或 litellm（Prompt 服務）。
GOVCHECK_PROMPT_PROVIDER=disabled
# provider=file 時的 prompt 目錄；相對路徑會錨定 repo root（格式見 docs/prompts.md）
GOVCHECK_PROMPT_DIR=prompts
GOVCHECK_PROMPT_BASE_URL=
GOVCHECK_PROMPT_API_KEY=
# production = 嚴格版（正式治理審查）；lenient = 寬鬆版（初步篩選／提案單位自助試跑）
# provider=file 時對應 prompts/<label>/ 子目錄，找不到才退回 prompts/ 根（見 docs/prompts.md）
GOVCHECK_PROMPT_LABEL=production
GOVCHECK_PROMPT_TIMEOUT=10

# ── F03 佐證混合檢索 ───────────────────────────────────────────────────────
# false 時使用 BM25-like；true 時以有上限的 embedding batches 融合 cosine 分數。
# 若 chunk 上限使語意檢索未涵蓋全文，空結果會標為 unknown／人工覆核，不會宣稱 not_found。
GOVCHECK_EVIDENCE_EMBEDDING_ENABLED=false
GOVCHECK_EVIDENCE_LEXICAL_WEIGHT=0.7
GOVCHECK_EVIDENCE_TOP_K=4
# 每段送入判讀模型的佐證原文摘錄上限；保留原文，不使用生成式摘要
GOVCHECK_EVIDENCE_EXCERPT_CHARS=600

# ── 佐證文件 parser（FileProcess 服務，HTTP，localhost） ───────────────────
# 佐證一律送 FileProcess 專案（POST /api/parse）解析；本專案不內嵌解析程式。
# 解析失敗只影響該份佐證（狀態 parser_unavailable / unreadable），規則檢查照常。
GOVCHECK_PARSER_ENABLED_FORMATS=.pdf,.docx,.xlsx,.txt,.csv,.tsv,.md,.pptx,.msg,.zip
# FileProcess 位址；主機必須列在 APPROVED_MODEL_HOSTS，否則不發請求（佐證不出本機）
GOVCHECK_PARSER_FILEPROCESS_URL=http://localhost:3322
GOVCHECK_PARSER_APPROVED_MODEL_HOSTS=localhost,127.0.0.1
# 單一文件解析請求逾時（秒）
GOVCHECK_PARSER_FILEPROCESS_TIMEOUT=120
GOVCHECK_PARSER_MAX_FILE_BYTES=52428800
# 單一文件回傳的 chunk 數上限（頁／工作表／附件段落）
GOVCHECK_PARSER_MAX_PAGES=200
# 舊鍵 GOVCHECK_PARSER_WORD_STRATEGY / MODEL_HOST / TIMEOUT / TEMP_ROOT / OCR_ENABLED / VLM_ENABLED
# 已無作用，留在 .env 會被靜默忽略，可刪除。

# ── 法規對照表（需求「專案內容是否合規」的審查基準） ────────────────────
# 凍結的靜態資產：由官方 R01–R07 PDF 與 F03 模板離線建置一次，runtime 只讀不寫。
# 檔案含法規原文 → gitignored，新環境需另外佈署；缺檔時報告會出 REGULATION.MAP_UNAVAILABLE。
# 建置管線已封存於 _Archive/rag_build/，法規改版時才取回重跑。
GOVCHECK_REGULATIONS_MAPPING_PATH=data/rag/retrieval_map.json
# 每個檢核項最多餵給模型的條文段數（prompt 預算）
GOVCHECK_REGULATIONS_MAX_SECTIONS_PER_ITEM=3
# 每段條文摘錄的字數上限
GOVCHECK_REGULATIONS_MAX_EXCERPT_CHARS=300
# F02 觸發題查表的引用上限（安全閥）
GOVCHECK_REGULATIONS_MAX_ITEMS=30

# ── 佐證檢索的 embeddings 端點（GOVCHECK_EVIDENCE_EMBEDDING_ENABLED=true 才會用到） ──
# OpenAI 相容 /embeddings；留空則沿用 GOVCHECK_LLM_BASE_URL
GOVCHECK_EMBEDDING_BASE_URL=http://localhost:11434/v1
GOVCHECK_EMBEDDING_MODEL=bge-m3
GOVCHECK_EMBEDDING_TIMEOUT=120
# 每次 HTTP 最多向量化筆數，避免合併成無上限 request
GOVCHECK_EMBEDDING_BATCH_SIZE=16
# embedding 端點單筆輸入最後安全上限
GOVCHECK_EMBEDDING_MAX_INPUT_CHARS=2000
# 每次 review 最多向量化的佐證 chunks；超過時均勻取樣，lexical 仍檢索全部 chunks
GOVCHECK_EMBEDDING_MAX_CHUNKS=512
# 機密：僅走環境變數，禁止寫入 yaml。本機 ollama 通常免填。
GOVCHECK_EMBEDDING_API_KEY=

# ── 覆核決定存放位置 ───────────────────────────────────────────────────────
# 治理人員在報告頁做的 accept／reject／na／pending 決定，以 review_id 為檔名存成 JSON。
# 含系統名與覆核註記 → 預設落在已 gitignore 的 output/decisions/，不入庫。
GOVCHECK_DECISION_DIR=output/decisions
